": [], "_data": [{"type": "instructions", "contents": [{"content": " John talks about his French girlfriend.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Move the words from the box to correctly complete the sentence.", "type": "text"}]}], "id": 9, "type": "MF1"}, {"questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "id": 10, "type": "RSLT"}, {"questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn8le08ob09re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": " My personal pet peeves.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n", "type": "text"}]}], "id": 11, "type": "DWS"}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "type": "scholar", "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "id": 0, "contents": [{}]}, {"type": "audio", "template_override": 1, "title": "", "_data": [], "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le08ob09re2img05.jpg", "audiosrc": "engenn8le08ob09re2aud01", "images": [{"time": "0", "image": "engenn8le08ob09re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le08ob09re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Rosa</span>:\t\tPeter! I'm so sorry again! I must have forgotten about the time.\n<br /><span class=\"strong\">Peter</span>:\t\tThat's alright. A buddy of mine was here, so I caught up with him. I had started to eat something with him before you finally arrived. I thought you might have stood me up.\n<br /><span class=\"strong\">Rosa</span>:\t\tYou sound irritable. I understand you like punctuality, but you may be taking this obsession a little too far.\n<br /><span class=\"strong\">Peter</span>:\t\tI just find it exasperating when people aren't on time."}, {"time": "26500", "image": "engenn8le08ob09re2img05.jpg", "id": 2, "text": "<span class=\"strong\">Rosa</span>:\t\tYou might want to loosen up, you know? I had planned on being on time until you started texting me every 5 minutes 2 hours before our date!\n<br /><span class=\"strong\">Peter</span>:\t\tI thought you could have used a reminder ...\n<br /><span class=\"strong\">Rosa</span>:\t\tI certainly didn't need 30 messages for that!\n<br /><span class=\"strong\">Peter</span>:\t\tI think I may have exaggerated. I had never dated an Italian until I met you. I can't handle you being late every time we go out."}, {"time": "51000", "image": "engenn8le08ob09re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Rosa</span>:\t\tLet me get it straight: are you breaking up with me? I may not be the most punctual person in the world, but I think you may be making a mistake. You could be a bit more open-minded, you know?\n<br /><span class=\"strong\">Peter</span>:\t\tI can't be relaxed when I'm out of my comfort zone, sorry.\n<br /><span class=\"strong\">Rosa</span>:\t\tWell, I'll get straight to the point. I had never dated a baseball nerd until I met you. I think this may be the first and last time."}]}}], "id": 1}, {"type": "text", "template_override": 1, "title": "", "_data": [], "contents": [{"type": "p", "value": "I really had thought that Italian girls were really nice, and they are. I mean, you know, they are beautiful and easy going, they are great to have a conversation with. But then, I discovered something very exasperating about them: they are not very punctual. My experience tells me not to go out with an italian girl again. I mean, it must be cool to have an italian girl as your girlfriend, but you might have to be a little less irritable and more open-minded."}], "id": 2}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Peter's Dating Misadventures", "type": "lesson_name"}, {"content": "The Appointment", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 8, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "  Describe complicated or unusual events in the past through a wider range of B1 language in both work and social contexts.", "type": "primary"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"content": "engenn8le08ob09re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " Expressing Understanding Using Modals (Modals for Possibility and Certainty )", "type": "heading"}, {"content": "You can use modals to talk about degrees of certainty.<br /> You use them to describe what is definite, probable, possible, or impossible from the speaker's point of view. ", "type": "describer"}, {"content": "You can use <span class=\"italic\">must</span>, <span class=\"italic\">may</span>, <span class=\"italic\">might</span>, and <span class=\"italic\">could</span> to describe degrees of certainty.<br /> You can use modals with the Present Perfect to talk about the possibility of a past event that is not clear in the present context.<br /> Example:<br /> <span class=\"italic\"> I <span class=\"strong\">must have forgotten </span>about the time</span>. <br /><br /> Must = it's very likely <br /> Must not / Could not / Can't = it's not possible<br /> May / Might / Can / Could = it's possible<br /> May not / Might not = it's possible this is not true<br />", "type": "text"}, {"content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\"> Modal </span> </div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\"> Meaning </span> </div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> I can't handle you being late. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's not possible for me to handle you being late. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> I may have exaggerated. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's possible that I may have exaggerated.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> I may not be the most punctual person in the world. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's not likely that I am the most punctual person in the world.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": " I understand you like punctuality, but you may be taking this obsession a little too far.", "type": "example"}, {"content": "You might want to loosen up, you know?", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " Expressing an Opinion About Past Events (Simple Past vs Past Perfect)", "type": "heading"}, {"content": "You use the Past Perfect tense to identify and talk about an 'earlier past'.<br />  You use the Simple Past to talk about a finished action that happened at a specific time in the past. ", "type": "describer"}, {"content": "When you are talking about a past event, you can refer to something that happened at an earlier time to that past event by using the <span class=\"underline\">Past Perfect</span> tense.<br /><br />  The structure of the Past Perfect is:<br /><br />  Subject + had + past participle <br /><br /> <span class=\"italic\">I <span class=\"strong\">had started </span>to eat something with him before you finally arrived</span>.<br /> Which event happened <span class=\"italic\">first</span>? I ate something.<br /> Which event happened <span class=\"italic\">later</span>? You arrived.<br /><br />  You use the Past Perfect tense (not Simple Past) when you want to talk about how long something had continued <span class=\"strong\">up to a past moment</span>. <br /><br />  Example: <br />  <span class=\"italic\">I had never dated an Italian until I met you</span>. <br /><br />  You use the Simple Past tense to talk about the action that happened after that prior action in the Past Perfect tense.", "type": "text"}, {"content": "I had planned on being on time until you started texting me every 5 minutes 2 hours before our date! ", "type": "example"}, {"content": "A buddy of mine was here, so I caught up with him. ", "type": "example"}, {"content": "I had started to eat something with him before you finally arrived.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to stand someone up", "type": "name"}, {"content": "to intentionally fail to meet somebody when you said you would", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I thought you might have stood me up.", "type": "example"}, {"content": "engenn8le08ob09aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you hear in a heated conversation.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "irritable ", "type": "name"}, {"content": "easily annoyed ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: You sound irritable. What's wrong?", "type": "example"}, {"content": "engenn8le08ob09aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "exasperating ", "type": "name"}, {"content": "extremely annoying ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I just find it exasperating when people aren't on time.", "type": "example"}, {"content": "engenn8le08ob09aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to loosen up", "type": "name"}, {"content": "to stop worrying and become more relaxed", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You might want to loosen up, you know?", "type": "example"}, {"content": "engenn8le08ob09aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "let me get it straight ", "type": "name"}, {"content": "to understand something clearly", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Let me get it straight: are you breaking up with me? ", "type": "example"}, {"content": "engenn8le08ob09aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to the point ", "type": "name"}, {"content": "relevant; pertinent to the matter at hand", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Well, I'll get straight to the point.", "type": "example"}, {"content": "engenn8le08ob09aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "open-minded ", "type": "name"}, {"content": "willing to consider and accept other people's ideas and opinions ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: You could be a bit more open-minded, you know?", "type": "example"}, {"content": "engenn8le08ob09aud07", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Write a list of five of your personal pet peeves (things that bother you). E.g. I hate it when people are late. It bothers me when people chew really loud.", "type": "text"}, {"content": "Present your list of pet peeves to a partner.", "type": "text"}, {"content": "Compare and discuss your lists.", "type": "text"}, {"content": "Create a new top-5 list by combining your list with your partners.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I make a list of things that bother me.", "type": "text"}, {"content": "I share my list with a partner.", "type": "text"}, {"content": "I combine my work with a partner's work.", "type": "text"}]}], "type": "sena"}