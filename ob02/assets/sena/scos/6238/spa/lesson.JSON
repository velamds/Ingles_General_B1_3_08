}]}]}], "stimuli_ids": [], "id": 10, "template_override": 1}, {"type": "DWS", "_data": [{"type": "instructions", "contents": [{"content": "Role-play a dialogue with your partner about a funny coincidence.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n", "type": "text"}]}], "questions": [{"responses": [{"id": 0, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "engenn8le08ob02re7pdf01.pdf", "type": "pdf"}]}]}], "stimuli_ids": [], "id": 11, "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"id": 0, "template_override": 1, "type": "welcome", "_data": [], "contents": [{}]}, {"type": "audio", "_data": [], "title": "", "template_override": 1, "id": 1, "contents": [{"value": {"images": [{"text": "", "image": "engenn8le08ob02re2img05.jpg", "time": "0", "id": 0}, {"text": "<span class=\"strong\">Peter</span>:\t\tTell me more about what happened to you at the gym. What did you say to Cathy when you saw her?\n<br /><span class=\"strong\">Matt</span>:\t\tI really wasn't expecting to bump into her! We had broken up before I moved to Cambridge, and I hadn't heard from her until last week!\n<br /><span class=\"strong\">Peter</span>:\t\tIt must be weird to meet an old flame after all these years! I thought you guys had moved on ...\n<br /><span class=\"strong\">Matt</span>:\t\tIt was a pleasant surprise, actually. The funny thing is that she had moved to Cambridge a few weeks before I did!", "image": "engenn8le08ob02re2img05.jpg", "time": "100", "id": 1}, {"text": "<span class=\"strong\">Peter</span>:\t\tWait, I know where this is going. She's also a regular at your gym, right?\n<br /><span class=\"strong\">Matt</span>:\t\tYeah! She's a total gym rat! When I saw her, she was walking around with a 50-pound dumbbell.\n<br /><span class=\"strong\">Peter</span>:\t\tWas she into weightlifting when you guys were going out together?\n<br /><span class=\"strong\">Matt</span>:\t\tNot at all. I don't remember her being particularly sporty. I wouldn't mess with her now, though!", "image": "engenn8le08ob02re2img01.jpg", "time": "24500", "id": 2}, {"text": "<span class=\"strong\">Peter</span>:\t\tYeah, she sounds tough! It looks like you guys were meant to be together!\n<br /><span class=\"strong\">Matt</span>:\t\tI wasn't planning on it! I was filling up my water bottle when she caught my eye. I thought I had forgotten about her until last week!\n<br /><span class=\"strong\">Peter</span>:\t\tWell, it sounds like you have rekindled your relationship. Speaking of which, what time is she supposed to come in?\n<br /><span class=\"strong\">Matt</span>:\t\tShe should be here soon. She just messaged me. She was getting ready to leave when her parents called her out of the blue.", "image": "engenn8le08ob02re2img01.jpg", "time": "43500", "id": 3}], "coverimg": "engenn8le08ob02re2img05.jpg", "audiosrc": "engenn8le08ob02re2aud01"}, "type": "slideshow"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "Peter's Dating Misadventures", "type": "lesson_name"}, {"content": "After All These Years", "type": "unit_name"}, {"content": 2, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 8, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "  Exchange information about people's interests and backgrounds using a wider range of language.", "type": "primary"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"content": "engenn8le08ob02re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " Past Perfect tense", "type": "heading"}, {"content": "You use the Past Perfect tense to identify and talk about an 'earlier past'.", "type": "describer"}, {"content": "When you are talking about a past event, you can refer to something that happened at an earlier time to that past event by using the <span class=\"underline\">Past Perfect</span> tense.<br /><br />  The structure of the Past Perfect is:<br /><br />  Subject + had + past participle<br /><br />  <span class=\"italic\">We <span class=\"strong\">had broken up </span>before I moved to Cambridge.<br /> Which event happened <span class=\"italic\">first</span>? We broke up.<br /> Which event happened <span class=\"italic\">later</span>? I moved to Cambridge.<br /><br />  You use the Past Perfect tense (not Simple Past) when you want to talk about how long something had continued <span class=\"strong\">up to a past moment. </span><br /><br />  Example:<br /> <span class=\"italic\">I hadn't heard from her until last week!</span>", "type": "text"}, {"content": "The funny thing is that she had moved to Cambridge a few weeks before I did! ", "type": "example"}, {"content": "I thought I had forgotten about her until last week! ", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " Simple Past vs Past Continuous", "type": "heading"}, {"content": "You use the Past Continuous to describe events in the past that were interrupted by another, shorter action.<br /> You use the Simple Past for past events or actions that have a clear beginning and end in the past.", "type": "describer"}, {"content": "The form of the Past Continuous is:<br /><br />  Subject + was/were + verb-ing<br /><br />  You can use the <span class=\"underline\">Past Continuous </span>to:<br /><br /> <ul> \t<li> to describe the background in a story written in the past tense  </li> </ul><br />  For example: <br /><br />   <span class=\"italic\">When I saw her, <span class=\"strong\">she was walking </span>around with a 50-pound dumbbell.</span><br /><br />   <ul> \t<li>to describe an action that was interrupted by another event or action </li> </ul><br /> For example:<br /><br />  <span class=\"italic\"><span class=\"strong\">She was getting </span>ready to leave when her parents called her out of the blue. </span>", "type": "text"}, {"content": "I really wasn't expecting to bump into her! ", "type": "example"}, {"content": "Was she into weightlifting when you guys were going out together?", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "old flame ", "type": "name"}, {"content": "used to refer to an ex girlfriend", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: It must be weird to meet an old flame after all these years!", "type": "example"}, {"content": "engenn8le08ob02aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you hear and use when talking about relationships.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to rekindle", "type": "name"}, {"content": "to revive or renew something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Well, it sounds like you have rekindled your relationship.", "type": "example"}, {"content": "engenn8le08ob02aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to move on ", "type": "name"}, {"content": "to concentrate one's attention or emotions on other matters in recovering from a setback or difficulty", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I thought you guys had moved on ...", "type": "example"}, {"content": "engenn8le08ob02aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "weightlifting ", "type": "name"}, {"content": "the lifting, pushing, or pulling of weights ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Was she into weightlifting when you guys were going out together?", "type": "example"}, {"content": "engenn8le08ob02aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "gym rat", "type": "name"}, {"content": "used to refer to someone who spends a lot of time at the gym", "type": "definition"}, {"content": " (expression)", "type": "part_speech"}, {"content": "Example: Yeah! She's a total gym rat! ", "type": "example"}, {"content": "engenn8le08ob02aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to mess with", "type": "name"}, {"content": "to use or handle something carelessly", "type": "definition"}, {"content": " (verb)", "type": "part_speech"}, {"content": "Example: I wouldn't mess with her now, though!", "type": "example"}, {"content": "engenn8le08ob02aud06", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "With a partner, write a dialogue (12-14 lines) about meeting a friend by chance after a long time.", "type": "text"}, {"content": "Role-play a surprising situation and describe the coincidence by which you met your friend. ", "type": "text"}, {"content": "Think of all the things you can talk about to catch up.  ", "type": "text"}, {"content": "Remember to use the appropriate tenses in the past.", "type": "text"}, {"content": "Share your dialogue with other partners.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about social activities.", "type": "text"}, {"content": "I discuss past experiences.", "type": "text"}, {"content": "I talk about what I was doing when something else happened.", "type": "text"}]}]}