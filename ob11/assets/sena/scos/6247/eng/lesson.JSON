 "type": "text"}], "selected": 0, "text": ""}, {"correct": true, "id": 3, "_data": [{"content": "hopeless", "type": "text"}], "selected": 0, "text": ""}, {"correct": 0, "id": 4, "_data": [{"content": "to me. ", "type": "text"}], "selected": 0, "text": ""}]}], "type": "ELS", "id": 2, "stimuli_ids": []}, {"template_override": 1, "_data": [{"contents": [{"content": "Sally is explaining to Peter that love and relationships don't work the way he thinks they do.", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Activity 2", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "allowed_attempts": 2}, "type": "feedback"}, {"contents": [{"content": "Reading", "type": "skill"}, {"content": "Listening", "type": "skill"}, {"content": "Speaking", "type": "skill"}], "type": "learning_skills"}, {"contents": [{"content": "Instructions: <span class=\"bullet\">Listen to the audio.</span> <span class=\"bullet\">Move the words up or down <span class=\"sena-icon sena-icon-vertical-drag\"></span> to complete each sentence.</span> <span class=\"bullet\">Record yourself saying the sentences aloud.</span> <span class=\"bullet\">Compare yourself to the audio.</span>", "type": "text"}, {"content": " You have 2 attempts to submit your answers.", "type": "text"}], "type": "post_instructions"}], "questions": [{"_data": [{"contents": [{"content": "engenn8le08ob11re4aud01", "type": "audio"}], "type": "question"}, {"content": "secondary_2", "type": "objective"}], "id": 0, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "but after a year I was ready to move on.", "type": "text"}], "selected": 0}]}, {"_data": [{"contents