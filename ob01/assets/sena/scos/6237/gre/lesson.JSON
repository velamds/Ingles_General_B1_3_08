": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "id": 10, "type": "RSLT"}, {"questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn8le08ob01re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": "Interview your partners.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n", "type": "text"}]}], "id": 11, "type": "DWS"}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "type": "scholar", "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "id": 0, "contents": [{}]}, {"type": "audio", "template_override": 1, "title": "", "_data": [], "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le08ob01re2img05.jpg", "audiosrc": "engenn8le08ob01re2aud01", "images": [{"time": "0", "image": "engenn8le08ob01re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le08ob01re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Peter</span>:\t\tHey Matt, long time no see!\n<br /><span class=\"strong\">Matt</span>:\t\tHow's it going Peter? I didn't know you liked this bar, too.\n<br /><span class=\"strong\">Peter</span>:\t\tI started coming here after work a couple of weeks ago. I had read about it in the paper last month before it opened. I really like the vibe here. What are you up to, anyway?\n<br /><span class=\"strong\">Matt</span>:\t\tI'm waiting for someone \u2026"}, {"time": "20500", "image": "engenn8le08ob01re2img02.jpg", "id": 2, "text": "<span class=\"strong\">Peter</span>:\t\tOh, like a date or something? It sounds like I may be interrupting.\n<br /><span class=\"strong\">Matt</span>\t:\tI'm meeting an old girlfriend, Cathy. We bumped into each other last week at the gym.\n<br /><span class=\"strong\">Peter</span>:\t\tThat explains why you look so buff now! You must have put on a few pounds of muscle since the last time I saw you!\n<br /><span class=\"strong\">Matt</span>:\t\tI could have. I had bought a gym subscription before my work schedule changed. I thought it would be a good way to keep fit and meet new people."}, {"time": "44500", "image": "engenn8le08ob01re2img01.jpg", "id": 3, "text": "<span class=\"strong\">Peter</span>:\tThat's a good idea. I certainly could use lifting some dumbbells right now. I had become quite athletic after all those soccer games, but I couldn't keep up with the practice sessions on top of my heavy workload.\n<br /><span class=\"strong\">Matt</span>:\tWe miss you, man. I'm sure you must miss the locker room conversations, too.\n<br /><span class=\"strong\">Peter</span>:\tYeah \u2026 I had grown fond of those. I was sad to give that up. I may come with you to the gym some time. Who knows, I might be lucky too!\n<br /><span class=\"strong\">Matt</span>:\t\tYou never know. That's how I met Cathy! I had just filled up my bottle at the water cooler when I saw her right in front of me!"}]}}], "id": 1}, {"type": "text", "template_override": 1, "title": "", "_data": [], "contents": [{"type": "p", "value": "<span class=\"strong\">Andy</span>: Hey! I never thought you liked this kind of place. I thought you were more the cafe type.\n<br/><span class=\"strong\">Friend</span>: Not really, I like cafes, of course, but recently I've started enjoying these places too.\n<br/><span class=\"strong\">Andy</span>: That's interesting! Two or three years ago you were so much into sports that hearing you also like going to bars is a surprise. \n<br/><span class=\"strong\">Friend</span>: Oh! I know! What about you ... ?"}], "id": 2}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Peter's Dating Misadventures", "type": "lesson_name"}, {"content": "An Old Girlfriend", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 8, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "  Exchange information about people's interests and backgrounds using a wider range of language.", "type": "primary"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"content": "engenn8le08ob01re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " Modals for Possibility and Certainty ", "type": "heading"}, {"content": "You can use modals to talk about degrees of certainty.<br /><br /> You use them to describe what is definite, probable, possible, or impossible from the speaker's point of view. ", "type": "describer"}, {"content": "You can use <span class=\"italic\">must, may, might,</span> and <span class=\"italic\">could</span> to describe degrees of certainty.<br /> You can use modals with the Present Perfect to talk about the possibility of a past event that is not clear in the present context.<br /> Example:<br /> <span class=\"italic\">You must have put on a few pounds of muscle since the last time I saw you!</span><br /><br />   Must = it's very likely <br /> Must not / Could not / Can't = it's not possible<br /> May / Might / Can / Could = it's possible<br /> May not / Might not = it's possible this is not true<br />", "type": "text"}, {"content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\">Modal</span></div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\">Meaning</span></div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> You must have put on a few pounds of muscle since the last time I saw you! </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" It's very likely you put on a few pounds.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">  I couldn't keep up with the practice sessions on top of my heavy workload.  </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" It wasn't possible to keep up.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> It sounds like I may be interrupting. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" It's possible that I'm interrupting.\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}]}, {"type": "learning_points", "contents": [{"content": " Talking About Life Experiences", "type": "heading"}, {"content": "You use the <span class=\"underline\">Past Perfect tense</span> to ...", "type": "describer"}, {"content": "I started coming here after work a couple of weeks ago.", "type": "example"}, {"content": "I had read about it in the paper last month before it opened.", "type": "example"}, {"content": "I had become quite athletic after all those soccer games, but I couldn't keep up with the practice sessions on top of my heavy workload. ", "type": "example"}, {"content": "</li><li>Identify and talk about an 'earlier past'. When you are talking about a past event, you can refer to something that happened at an earlier time to that past event by using the Past Perfect tense.</li></ul>", "type": "text"}, {"content": "The structure of the Past Perfect is: <br> Subject + had + past participle <br /><br />  <span class=\"italic\">I <span class=\"strong\">had read </span>about the restaurant in the paper last month before it opened.</span><br /> Which event happened <span class=\"italic\">first</span>? I read about the restaurant in the paper.<br /> Which event happened<span class=\"italic\"> later</span>? The restaurant opened.<br /><br /> ", "type": "text"}, {"content": "</li><li>You can also use the Past Perfect tense when you want to talk about how long something had continued up to a past moment.</li></ul><br /> Example:<br /> <span class=\"italic\">I had grown fond of those</span>.", "type": "text"}, {"content": "You use the <span class=\"underline\">Simple Past tense </span>to... ", "type": "text"}, {"content": "</li><li>Talk about a finished action that happened at a specific time in the past.</li></ul>                                                                         ", "type": "text"}, {"content": "</li><li>Talk about the action that happened after that prior action in the Past Perfect tense.</li></ul> <br /> Example:<br /> <span class=\"italic\">After I<span class=\"strong\"> had finished</span> working out, I <span class=\"strong\">bumped into</span> an old friend.</span>", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "buff ", "type": "name"}, {"content": "used to describe a person who exercises a lot", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: That explains why you look so buff now! You must have put on a few pounds of muscle since the last time I saw you! ", "type": "example"}, {"content": "engenn8le08ob01aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use at the gym.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "muscle ", "type": "name"}, {"content": "a part of the body that contracts to produce movement", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You must have put on a few pounds of muscle since the last time I saw you!", "type": "example"}, {"content": "engenn8le08ob01aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to lift ", "type": "name"}, {"content": "to raise or direct upward", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I must go back to the gym and start lifting weights again.", "type": "example"}, {"content": "engenn8le08ob01aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "dumbbell ", "type": "name"}, {"content": "an object with two metal balls connected by a bar used as a weight for exercising", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I certainly could use lifting some dumbbells right now. ", "type": "example"}, {"content": "engenn8le08ob01aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "athletic ", "type": "name"}, {"content": " physically active and strong", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I had become quite athletic after all those soccer games.", "type": "example"}, {"content": "engenn8le08ob01aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "locker room ", "type": "name"}, {"content": "a room containing lockers, as in a gym", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'm sure you must miss the locker room conversations.", "type": "example"}, {"content": "engenn8le08ob01aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "water cooler ", "type": "name"}, {"content": "a drinking fountain in which water is cooled by refrigeration", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I had just filled up my bottle at the water cooler when I saw her right in front of me!", "type": "example"}, {"content": "engenn8le08ob01aud07", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Find 4 or 5 partners. Prepare 2 questions for each partner.", "type": "text"}, {"content": "Ask each partner about a hobby or a pastime that they have given up.", "type": "text"}, {"content": "Remember to use the right tenses in the past to answer the questions.", "type": "text"}, {"content": "React to the partners' questions using modals for certainty or possibility.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about social activities and pastimes.", "type": "text"}, {"content": "I discuss past experiences.", "type": "text"}, {"content": "I express possibility and certainty.", "type": "text"}]}], "type": "sena"}